# Konfigurasi Ollama untuk SakuraSensei AI
# Ganti dengan API Key Ollama Anda jika menggunakan cloud / remote
OLLAMA_API_KEY="your_ollama_api_key_here"

# Model AI (contoh: glm-5.3-flash:cloud, llama3, qwen2.5, dll.)
OLLAMA_MODEL="glm-5.3-flash:cloud"

# Base URL Ollama (https://ollama.com atau http://localhost:11434 untuk lokal)
OLLAMA_BASE_URL="https://ollama.com"

# Port Web Server
PORT=3000
